+impl Drop for Node {
+    /// Frees the node's descendants one at a time rather than recursively.
+    ///
+    /// Each node owns its children, so the default drop frees a tree by recursing as deep as it
+    /// is nested. HTML from a message is nested as deep as its sender likes (thousands of levels
+    /// fit in one event), which overflows the stack and crashes the process. Here the children of
+    /// a node being freed are moved to a list first, and a child is only opened up in turn when
+    /// this was its last owner: one still held elsewhere keeps its subtree intact.
+    fn drop(&mut self) {
+        let mut pending = std::mem::take(self.children.get_mut());
+        while let Some(node) = pending.pop() {
+            if Rc::strong_count(&node.0) == 1 {
+                pending.append(&mut node.0.children.borrow_mut());
+            }
+            // `node` now has no children of its own left to free, so dropping it doesn't recurse.
+        }
+    }
+}
+
 /// The data of a `Node`.
 #[derive(Debug, Clone)]
 #[allow(clippy::exhaustive_enums)]
diff --git a/crates/ruma-html/tests/it/deep_nesting.rs b/crates/ruma-html/tests/it/deep_nesting.rs
new file mode 100644
index 0000000..f74d5bd
--- /dev/null
+++ b/crates/ruma-html/tests/it/deep_nesting.rs
@@ -0,0 +1,29 @@
+use ruma_html::{Html, HtmlSanitizerMode, RemoveReplyFallback, sanitize_html};
+
+/// HTML nested far deeper than any real message, as a hostile sender can send it.
+fn deeply_nested(depth: usize) -> String {
+    "<ul>".repeat(depth) + "<li>deep</li>" + &"</ul>".repeat(depth)
+}
+
+/// Runs `work` on a thread with a stack as small as a Swift concurrency thread's (512 KiB),
+/// which is where an app calling into the Matrix SDK may parse a message.
+fn on_small_stack(work: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new().stack_size(512 * 1024).spawn(work).unwrap().join().unwrap();
+}
+
+#[test]
+fn deeply_nested_html_is_freed_without_overflowing_the_stack() {
+    let html = deeply_nested(20_000);
+    on_small_stack(move || drop(Html::parse(&html)));
+}
+
+#[test]
+fn deeply_nested_html_is_sanitized_as_the_sdk_does_it() {
+    let html = deeply_nested(20_000);
+    on_small_stack(move || {
+        let clean = sanitize_html(&html, HtmlSanitizerMode::Compat, RemoveReplyFallback::Yes);
+        // Elements beyond the specification's depth limit are removed.
+        assert!(!clean.contains("deep"));
+        assert!(clean.starts_with("<ul>"));
+    });
+}
